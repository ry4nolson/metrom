# Copy to keystore.properties (gitignored) and fill in real values:
#   cp keystore.properties.example keystore.properties
#
# Create the keystore once (run from the repo root):
#   keytool -genkeypair -v \
#     -keystore metrom-release.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 \
#     -alias metrom \
#     -storepass YOUR_STORE_PASSWORD \
#     -keypass YOUR_KEY_PASSWORD \
#     -dname "CN=Metrom, OU=Mobile, O=Metrom, L=City, ST=State, C=US"
#
# Keep metrom-release.jks and keystore.properties OUT of git. Back them up offline.

storeFile=metrom-release.jks
storePassword=YOUR_STORE_PASSWORD
keyAlias=metrom
keyPassword=YOUR_KEY_PASSWORD
