<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Connect IQ TETHERED (simulator) binds a ServerSocket on :7381. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Beat haptics (ViewModel vibrator). Install-time permission. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Ambient tempo listen (foreground only; not used by the playback FGS). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Generic FGS declaration required to run a foreground service (API 28+). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- Typed FGS for the mediaPlayback metronome notification (API 34+ Play requirement). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- Transport notification on Android 13+. Optional at runtime — audio still works if denied. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <queries>
        <package android:name="com.garmin.android.apps.connectmobile" />
    </queries>

    <application
        android:name=".MetromApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Metrom">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Metrom"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>
</manifest>
